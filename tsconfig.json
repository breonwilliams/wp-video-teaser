{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "declaration": false,
    "outDir": "./assets/js",
    "rootDir": "./src/ts",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./src/ts/types"]
  },
  "include": ["src/ts/**/*", "src/ts/types/**/*"]
}
